# Moncraft conversion channels — leave blank until verified business values exist.
# Copy to `.env.local` for local development. Never invent placeholders that look live.

# ---------------------------------------------------------------------------
# Public handoff channels (safe for NEXT_PUBLIC_* — appear in browser links)
# ---------------------------------------------------------------------------

# Work inbox for mailto "Request a Quote" (public — appears in client mailto links)
NEXT_PUBLIC_MONKCRAFT_ENQUIRY_EMAIL=

# Google Calendar appointment schedule HTTPS URL (preferred).
# Example shape: https://calendar.google.com/calendar/appointments/schedules/...
# Other https booking hosts are accepted only if they are your verified schedule.
NEXT_PUBLIC_MONKCRAFT_BOOKING_URL=

# WhatsApp Business number as E.164 digits only (no +, spaces, or dashes), e.g. 9198XXXXXXXX
NEXT_PUBLIC_MONKCRAFT_WHATSAPP_E164=

# ---------------------------------------------------------------------------
# Server-side quote request storage and Notion sync (required for online submit)
# Never put these values in NEXT_PUBLIC_*. Configure secrets in Vercel settings.
# ---------------------------------------------------------------------------

# Supabase project URL and service role key. Use only server-side.
MONKCRAFT_SUPABASE_URL=
MONKCRAFT_SUPABASE_SERVICE_ROLE_KEY=

# Notion internal integration. Share the parent page with this integration.
MONKCRAFT_NOTION_TOKEN=
MONKCRAFT_NOTION_LEADS_DATA_SOURCE_ID=
MONKCRAFT_NOTION_SUPPLIERS_DATA_SOURCE_ID=
MONKCRAFT_NOTION_SUPPLIER_CHECKS_DATA_SOURCE_ID=
MONKCRAFT_NOTION_QUOTES_ORDERS_DATA_SOURCE_ID=
MONKCRAFT_NOTION_CUSTOMER_CARE_DATA_SOURCE_ID=
MONKCRAFT_NOTION_CONTENT_DATA_SOURCE_ID=
MONKCRAFT_NOTION_AGENT_FEEDBACK_DATA_SOURCE_ID=

# Optional supervised content drafting. Server-only; invoked only by a signed-in
# staff member. Drafts are stored for review and are never auto-published.
OPENAI_API_KEY=
MONKCRAFT_MARKETING_MODEL=gpt-5.4-mini
MONKCRAFT_SALES_MODEL=gpt-5.4-mini

# Vercel cron request authorization for retrying the Notion outbox.
CRON_SECRET=

# Operations-only endpoints: human approval and send of supplier availability
# checks. Use a random value with at least 32 characters. Keep server-only and
# distinct from CRON_SECRET. Pilot staff share this key; do not reuse passwords.
MONKCRAFT_OPS_API_SECRET=

# Official Meta WhatsApp Business Platform webhook and approved template send.
# Configure only after the business number, supplier opt-ins, and template are verified.
META_APP_SECRET=
MONKCRAFT_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
MONKCRAFT_WHATSAPP_ACCESS_TOKEN=
MONKCRAFT_WHATSAPP_PHONE_NUMBER_ID=
MONKCRAFT_WHATSAPP_GRAPH_API_VERSION=
MONKCRAFT_SUPPLIER_AVAILABILITY_TEMPLATE=
MONKCRAFT_SUPPLIER_TEMPLATE_LANGUAGE=en

# Local, one-time Notion bootstrap only. Do not add to deployed web env.
MONKCRAFT_NOTION_PARENT_PAGE_ID=

# The legacy Resend variables below are not used to confirm quote request
# receipt. Durable database storage is the receipt boundary.

# Must be exactly: true
# MONKCRAFT_ENQUIRY_DELIVERY_ENABLED=

# Only supported foundation provider today: resend
# MONKCRAFT_ENQUIRY_PROVIDER=

# Server-only API key from the approved provider
# MONKCRAFT_ENQUIRY_API_KEY=

# Destination inbox that receives structured quotation emails
# MONKCRAFT_ENQUIRY_TO_EMAIL=

# Verified sender address at the provider (e.g. enquiries@yourdomain.com)
# MONKCRAFT_ENQUIRY_FROM_EMAIL=
