# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local / heavy artefacts (not for git)
/tmp/
/.tmp-pdf-slides/
# Audit crawl evidence (traces/screenshots, ~74MB) — reports are kept, raw evidence is not
/docs/audits/evidence/
/tmp-audit/
# Stray nested build output
/monkcraft-gifting-co/
# Never commit catalogue media (~804MB). Keep as local symlink; CLI Preview uses a staging copy.
/public/catalogue-media
/public/catalogue-media/
